<Window x:Class="DenzGames.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DenzGames" Width="1180" Height="760" MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="46" Height="46" CornerRadius="13" Background="{StaticResource AccentBrush}">
                    <TextBlock Text="D" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="14,0,0,0">
                    <TextBlock Text="DenzGames" FontSize="28" FontWeight="Bold" />
                    <TextBlock Text="Your games. One launcher." Foreground="{StaticResource MutedTextBrush}" FontSize="13" />
                </StackPanel>
            </StackPanel>
            <Border Grid.Column="1" Background="#17213A" CornerRadius="20" Padding="14,7" VerticalAlignment="Center">
                <TextBlock x:Name="LibraryCountText" Text="Memuat katalog..." Foreground="#C8D0E7" FontSize="13" />
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="390" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="GAME LIBRARY" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="8,4,0,14" />
                    <ListBox x:Name="GameList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                             SelectionChanged="GameList_OnSelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="#8FA0C5" Margin="8,8,0,9" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Margin" Value="0,0,0,8" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Card" CornerRadius="12" Padding="12" Background="#131F36">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Card" Property="Background" Value="{StaticResource PanelHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Card" Property="Background" Value="#29305A" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="44" Height="44" CornerRadius="10" Background="#7C5CFC">
                                        <Image Source="{Binding Icon}" Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" />
                                        <TextBlock Text="{Binding VersionAndUpdate}" Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="10.5" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="30">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="26" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="SelectedNameText" Text="Pilih game" FontSize="34" FontWeight="Bold" />
                        <TextBlock x:Name="SelectedMetaText" Foreground="#A99BFF" FontSize="13" Margin="0,8,0,0" />
                        <TextBlock x:Name="SelectedUpdateText" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,6,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="SelectedDescriptionText" Grid.Row="1" TextWrapping="Wrap" FontSize="16"
                               Foreground="#C8D0E7" Margin="0,18,0,0" LineHeight="24" />

                    <StackPanel Grid.Row="3">
                        <TextBlock Text="PERSYARATAN SISTEM" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                        <ItemsControl x:Name="PrerequisiteList" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0D1628" CornerRadius="10" Padding="14" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Symbol}" FontSize="17" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Margin="12,0">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Message}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="Bantuan" Padding="12,7" FontSize="11" Tag="{Binding Id}"
                                                    Visibility="{Binding HelpVisibility}" Click="PrerequisiteHelp_OnClick" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Border Grid.Row="4" Background="#0D1628" CornerRadius="12" Padding="16" Margin="0,12,0,18" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="STATUS" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock x:Name="StatusText" Text="Pilih salah satu game untuk memulai." TextWrapping="Wrap" Margin="0,7,0,0" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="RefreshButton" Content="Periksa ulang" Background="#263451" Click="RefreshButton_OnClick" Margin="0,0,12,0" />
                        <Button x:Name="PlayButton" Grid.Column="1" Content="▶  PLAY" MinWidth="150" IsEnabled="False" Click="PlayButton_OnClick" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" x:Name="FooterText" Text="DenzGames • Windows Game Launcher" Foreground="#69758F" FontSize="11" Margin="2,16,0,0" />
    </Grid>
</Window>

